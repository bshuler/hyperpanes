// The left slide-out panel (mux plan M5) — the workspace tree, the saved-workspace
// library, the saved workspace sets (M6), and the detached (adoptable) sessions.
//
//   ┌─────────────┬──────────  a 300px panel living to the LEFT of the pane area, a real
//   │ PANELS     ×│  panes     SIBLING of it (exactly like the right-edge rail): NOT an
//   │ ▾ WORKSPACE │            overlay, so there is no scrim and the panes are never
//   │  ▾ term 1   │            dimmed — the pane area simply shrinks. Toggled by a
//   │    ● claude │            `Command` (`ToggleLeftPanel`, Seam #2); every row it draws
//   │    ● shell  │            is projected by `paneview::resync` (Seam #1) into the
//   │ ▾ LIBRARY  💾            `LeftPanelAdapter` global, mirroring the way the rail's
//   │ ▾ SETS     💾            reminder section is fed.
//   │ ▾ DETACHED  │
//   └─────────────┴──────────
//
// Section 1 — WORKSPACE: a two-level tree (tab → its panes). Clicking a pane switches to
// its tab and focuses it; DRAGGING a pane onto another tab's group moves it there (the
// panel hit-tests the drop itself, in absolute window coordinates, and hands the
// controller a (from-tab, pane, to-tab) triple). Each pane carries a liveness dot fed by
// the same activity source the idle glow uses.
// Section 2 — LIBRARY: the saved workspaces on disk; one click loads one, the header's
// save button writes the current tab into the library.
// Section 3 — SETS: the saved workspace SETS — a set is a named group of workspaces, so
// one click here opens several tabs at once. The header's save button stores every
// non-empty tab in this window as a new set. Kept separate from LIBRARY rather than mixed
// into it because the two behave differently on click: a library row appends ONE tab, a
// set row appends one per member.
// Section 4 — DETACHED: live sessions no window in this process is showing; one click
// adopts one back into the active tab.
//
// Every icon here is DRAWN geometry (Path / composed Rectangles), never a font glyph:
// Slint on Windows silently drops codepoints the resolved font lacks (the df73005 chevron
// failure), so a PUA icon renders as nothing at all.

import { Theme } from "theme.slint";
import { TipArea } from "tooltip.slint";
import { LeftPaneRow, LeftTabRow, LeftWorkspaceRow, LeftSetRow, LeftSessionRow, LeftModeRow, LeftSessionItem, LeftPanelAdapter } from "types.slint";
// The branded tool marks live in the shared widget library (the pane header needs them too,
// and the app can only import one way across that boundary). Same hard rule as every glyph
// in this file: drawn geometry, never a font.
import { ToolIcon } from "@widgets";

// A disclosure chevron: pointing down when the section is open, right when it is closed.
component ChevronGlyph inherits Path {
    in property <color> ink;
    in property <bool> open;
    width: 10px;
    height: 10px;
    viewbox-width: 12;
    viewbox-height: 12;
    stroke: ink;
    stroke-width: 1.7px;
    fill: transparent;
    commands: root.open
        ? "M 2.5 4.5 L 6 8 L 9.5 4.5"
        : "M 4.5 2.5 L 8 6 L 4.5 9.5";
}

// The panel's × (close) — two crossed strokes.
component CloseGlyph inherits Path {
    in property <color> ink;
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    stroke: ink;
    stroke-width: 1.5px;
    fill: transparent;
    commands: "M 2 2 L 10 10 M 10 2 L 2 10";
}

// The WORKSPACE mode's own mark: a 2x2 pane grid, standing for the tab/pane tree. Drawn
// rather than borrowed from ToolIcon because mode 0 is not a tool and has no brand.
component GridGlyph inherits Rectangle {
    in property <color> ink;
    width: 14px;
    height: 14px;
    Rectangle { x: 1px;   y: 1px;   width: 5px; height: 5px; border-radius: 1px; background: root.ink; }
    Rectangle { x: 8px;   y: 1px;   width: 5px; height: 5px; border-radius: 1px; background: root.ink; }
    Rectangle { x: 1px;   y: 8px;   width: 5px; height: 5px; border-radius: 1px; background: root.ink; }
    Rectangle { x: 8px;   y: 8px;   width: 5px; height: 5px; border-radius: 1px; background: root.ink; }
}

// One button in the mode strip. Fixed 26x24 so the strip's height never depends on what is
// inside it — the panel's layout has been broken twice by a child whose height came back
// through a reactive read (b0c6637, 5c2eef5), and a constant is the cheap way to not care.
component ModeButton inherits Rectangle {
    in property <LeftModeRow> mode-row;
    in property <bool> active;
    callback clicked();
    width: 26px;
    height: 24px;
    border-radius: 5px;
    background: root.active ? Theme.surface2 : (ma.has-hover ? Theme.surface : transparent);
    // The active mode is underlined in its own brand, so the strip reads as "which tool am
    // I looking at" even at a glance. Mode 0 has no brand and falls back to the accent.
    Rectangle {
        x: 5px;
        y: parent.height - 3px;
        width: 16px;
        height: 2px;
        border-radius: 1px;
        visible: root.active;
        background: root.mode-row.icon == 0 ? Theme.accent : root.mode-row.brand;
    }
    // icon == 0 is the workspace mode; anything else is a registry icon kind.
    if root.mode-row.icon == 0 : GridGlyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 1px;
        ink: root.active ? Theme.text : Theme.subtext;
    }
    if root.mode-row.icon != 0 : ToolIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 1px;
        kind: root.mode-row.icon;
        // A dimmed brand when inactive, full brand when selected: the strip stays branded
        // without four saturated logos fighting for attention at once.
        ink: root.active ? root.mode-row.brand : root.mode-row.brand.darker(0.35);
    }
    ma := TipArea {
        tip: root.mode-row.label;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A floppy-disk "save" glyph (stroked body + shutter + label) for the LIBRARY header.
component SaveGlyph inherits Path {
    in property <color> ink;
    width: 14px;
    height: 14px;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: ink;
    stroke-width: 1.3px;
    fill: transparent;
    commands: "M 2.5 2.5 L 11 2.5 L 13.5 5 L 13.5 13.5 L 2.5 13.5 Z M 5.5 2.5 L 5.5 6.3 L 10.3 6.3 L 10.3 2.5 M 4.8 13.5 L 4.8 9.3 L 11.2 9.3 L 11.2 13.5";
}

// An "adopt" glyph: an arrow entering a bracket — take this loose session INTO the window.
component AdoptGlyph inherits Path {
    in property <color> ink;
    width: 14px;
    height: 14px;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: ink;
    stroke-width: 1.3px;
    fill: transparent;
    commands: "M 2 8 L 9.5 8 M 6.4 4.9 L 9.6 8 L 6.4 11.1 M 11.5 3 L 14 3 L 14 13 L 11.5 13";
}

// The per-pane liveness dot. Its strength is the controller's `live` (1 = output right
// now, fading toward 0 across the liveness window — computed in `leftpanel::liveness`
// from `SessionManager::last_output_at`, the SAME source the idle glow reads; there is no
// second activity source in the app). A pane whose idle glow has armed (an AI pane quiet
// past the alert threshold) overrides the fade with a ringed accent dot, so the tree flags
// the pane that is waiting for you even when it is scrolled off screen.
component LiveDot inherits Rectangle {
    in property <float> live;
    in property <bool> idle;
    in property <color> tint;
    width: 9px;
    height: 9px;
    border-radius: 4.5px;
    background: root.idle ? Theme.accent : root.tint;
    // never fully invisible: a quiet pane still needs its color chip.
    opacity: root.idle ? 1.0 : max(0.22, root.live);
    border-width: root.idle ? 1.5px : 0px;
    border-color: Theme.text;
}

// One pane row in the workspace tree. Click = focus; press-and-drag = move to another tab
// (the drag is reported in ABSOLUTE window coordinates, which the tab groups hit-test).
component PaneRowView inherits Rectangle {
    in property <LeftPaneRow> pane;
    // True while this row is the one being dragged (dims it, so the drop target reads).
    in property <bool> dragging;
    callback activate();
    callback drag-moved(length);   // absolute y of the pointer
    callback drag-released();

    // Whether the current press has already turned into a drag — set once past the 4px of
    // slop, and consulted by `clicked` so releasing a drag over the source row does not
    // also focus it (Slint delivers `clicked` after the pointer-up).
    property <bool> dragged: false;
    property <length> press-y: 0;

    height: 26px;
    border-radius: 5px;
    background: root.dragging ? Theme.surface : (ta.has-hover ? Theme.surface2 : transparent);
    opacity: root.dragging ? 0.55 : 1.0;

    ta := TipArea {
        tip: "Focus this pane · drag to reorder or move it to another tab";
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.dragged = false;
                // Imperative read inside an event handler, NOT a reactive binding: reading
                // `absolute-position` from a binding during layout trips Slint's recursion
                // guard (see the note in topbar.slint).
                root.press-y = self.absolute-position.y + self.mouse-y;
            }
            if (e.kind == PointerEventKind.up && root.dragged) {
                root.drag-released();
            }
        }
        moved => {
            if (self.pressed) {
                // 4px of slop, so a shaky click still focuses instead of arming a drag.
                if (self.absolute-position.y + self.mouse-y > root.press-y + 4px
                    || self.absolute-position.y + self.mouse-y < root.press-y - 4px) {
                    root.dragged = true;
                }
                if (root.dragged) {
                    root.drag-moved(self.absolute-position.y + self.mouse-y);
                }
            }
        }
        clicked => {
            if (!root.dragged) { root.activate(); }
        }
    }

    HorizontalLayout {
        padding-left: 29px;      // indent, under the tab's chevron (past the colour rail)
        padding-right: 8px;
        spacing: 7px;

        VerticalLayout {
            alignment: center;
            LiveDot {
                live: root.pane.live;
                idle: root.pane.idle;
                tint: root.pane.tint;
            }
        }

        Text {
            text: root.pane.title;
            color: root.pane.focused ? Theme.text : Theme.subtext;
            font-size: 12px;
            font-weight: root.pane.focused ? 700 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

// One tab group in the workspace tree: the tab header plus its pane rows. The WHOLE group
// is the drop zone for a pane drag (a far easier target than the header alone), and it
// hit-tests itself: `drop-hover` compares the panel's published absolute drag-y against
// this group's own absolute rect. The `&&` is ordered so `absolute-position` is only a
// dependency WHILE a drag is in flight, and the result feeds colors only — never geometry,
// no conditional child inserted into a layout — so it cannot close a layout cycle.
component TabRowView inherits Rectangle {
    in property <LeftTabRow> tab;
    in property <bool> drag-active;
    in property <length> drag-y;
    in property <bool> is-source;      // the drag started in this tab (a drop here = reorder)
    in property <int> drag-pane;       // pane index being dragged (only when `is-source`)
    callback activate(int);            // pane index clicked
    callback drag-moved(int, length);  // (pane index, absolute y)
    callback drag-released();
    // This group is / is no longer the drop target, and the insertion slot within it.
    callback hover-changed(bool, int);

    property <bool> expanded: true;

    // `drop-hover` is a PLAIN property recomputed from the drag events — never a reactive
    // binding. Reading `absolute-position` (or `height`) inside a binding makes that binding
    // depend on the ancestor box layout, and the `changed drop-hover` handler below forces it
    // to be evaluated during this repeated item's own `init` — i.e. while the repeater has
    // built some TabRowViews but not yet all of them. `solve_box_layout` then trips
    //   assertion failed: result.len() >= total_repeated_cells * 2
    // because the cell vector is short one entry for every sibling that does not exist yet,
    // and the entire WORKSPACE tree fails to build: the section renders empty. Recomputing
    // from `changed drag-*` keeps every geometry read in an event handler, where resolving the
    // layout is safe because the tree is already built.
    property <bool> drop-hover: false;

    // Where inside this group the pointer sits: an insertion index among its pane rows
    // (0 = above the first, panes.length = below the last), or -1 when the group is
    // collapsed and has no rows to insert between. Derived from the two row metrics below
    // rather than from the rows themselves, so it needs no per-row geometry report — and,
    // like `drop-hover`, it is only ever assigned from an event handler.
    property <int> drop-slot: -1;
    // Mirrors the layout below: a 28px header plus the VerticalLayout's 1px spacing, then a
    // 26px row every 27px. Change these together with the layout.
    property <length> header-h: 29px;
    property <length> row-pitch: 27px;

    function refresh-drop-hover() {
        root.drop-hover = root.drag-active
            && root.drag-y >= root.absolute-position.y
            && root.drag-y <= root.absolute-position.y + root.height;
        if (root.drop-hover && root.expanded) {
            root.drop-slot = clamp(round((root.drag-y - root.absolute-position.y - root.header-h)
                / root.row-pitch), 0, root.tab.panes.length);
        } else {
            root.drop-slot = -1;
        }
        root.hover-changed(root.drop-hover, root.drop-slot);
    }

    changed drag-y => { root.refresh-drop-hover(); }
    changed drag-active => { root.refresh-drop-hover(); }
    changed is-source => { root.refresh-drop-hover(); }

    border-radius: 6px;
    // The source group gets the caret alone (a reorder does not change the pane's home);
    // any other group also gets the wash, because the drop moves the pane into it.
    border-width: root.drop-hover && !root.is-source ? 1px : 0px;
    // The drop highlight wears the DESTINATION group's colour, so a pane in flight shows
    // you the halo it is about to take on rather than a generic accent.
    border-color: root.tab.tint;
    background: root.drop-hover && !root.is-source ? root.tab.tint.with-alpha(0.12) : transparent;

    // The insertion caret: exactly where the row will land. Absolutely positioned inside
    // this Rectangle (not a layout child), so it adds no cell to any box layout and its
    // geometry reads only plain properties.
    if root.drop-hover && root.drop-slot >= 0 : Rectangle {
        x: 8px;
        y: root.header-h + (root.drop-slot * root.row-pitch) - 2px;
        width: parent.width - 16px;
        height: 2px;
        border-radius: 1px;
        background: root.tab.tint;
    }

    VerticalLayout {
        spacing: 1px;

        // ---- tab header ----
        Rectangle {
            height: 28px;
            border-radius: 5px;
            // The active group carries a wash of its own colour; hover stays neutral so the
            // two readings never fight.
            background: hta.has-hover ? Theme.surface2
                : (root.tab.active ? root.tab.tint.with-alpha(0.13) : transparent);

            hta := TipArea {
                tip: "Switch to this tab";
                mouse-cursor: pointer;
                // Clicking the header focuses the tab through its FIRST pane: the tree has
                // no separate "switch tab" command, because focusing a pane already
                // switches to the tab that owns it.
                clicked => { root.activate(0); }
            }

            HorizontalLayout {
                padding-left: 2px;
                padding-right: 8px;
                spacing: 4px;

                // the group's colour rail — the tab's link to its pane halo. Full strength
                // on the active tab, dimmed on the rest so the tree still has one focus.
                Rectangle {
                    width: 3px;
                    Rectangle {
                        width: 3px;
                        height: 16px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 1.5px;
                        background: root.tab.tint;
                        opacity: root.tab.active ? 1.0 : 0.45;
                    }
                }

                // expand toggle (drawn chevron, never a font glyph)
                Rectangle {
                    width: 18px;
                    ChevronGlyph {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        open: root.expanded;
                        ink: cta.has-hover ? root.tab.tint : Theme.subtext;
                    }
                    cta := TipArea {
                        tip: root.expanded ? "Collapse this tab's panes" : "Show this tab's panes";
                        mouse-cursor: pointer;
                        clicked => { root.expanded = !root.expanded; }
                    }
                }

                Text {
                    text: root.tab.title;
                    color: root.tab.active ? Theme.text : Theme.subtext;
                    font-size: 13px;
                    font-weight: root.tab.active ? 700 : 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                // pane-count chip
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 15px;
                        border-radius: 7px;
                        background: root.tab.tint.with-alpha(root.tab.active ? 0.28 : 0.16);
                        Text {
                            text: root.tab.panes.length;
                            color: root.tab.active ? root.tab.tint : Theme.subtext;
                            font-size: 9px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }
        }

        // ---- the tab's panes ----
        if root.expanded : VerticalLayout {
            spacing: 1px;
            for p[j] in root.tab.panes : PaneRowView {
                pane: p;
                dragging: root.is-source && root.drag-pane == j;
                activate => { root.activate(j); }
                drag-moved(y) => { root.drag-moved(j, y); }
                drag-released => { root.drag-released(); }
            }
        }
    }
}

// One saved workspace in the library section.
component WorkspaceRowView inherits Rectangle {
    in property <LeftWorkspaceRow> ws;
    callback activate();
    height: 36px;
    border-radius: 5px;
    background: wa.has-hover ? Theme.surface2 : transparent;

    wa := TipArea {
        tip: "Open this saved workspace";
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.ws.name;
                color: Theme.text;
                font-size: 12px;
                overflow: elide;
            }
            Text {
                text: root.ws.detail;
                color: Theme.subtext;
                font-size: 10px;
                overflow: elide;
            }
        }
    }
}

// Two stacked sheets — marks a SETS row as a *group of* workspaces at a glance, so the
// two library sections don't read as one long undifferentiated list.
component StackGlyph inherits Path {
    in property <color> ink;
    width: 12px;
    height: 12px;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: ink;
    stroke-width: 1.3px;
    fill: transparent;
    commands: "M 5.5 2.5 L 13.5 2.5 L 13.5 10.5 M 2.5 5.5 L 10.5 5.5 L 10.5 13.5 L 2.5 13.5 Z";
}

// One saved workspace set in the sets section. One click opens every member.
component SetRowView inherits Rectangle {
    in property <LeftSetRow> set;
    callback activate();
    height: 36px;
    border-radius: 5px;
    background: sta.has-hover ? Theme.surface2 : transparent;

    sta := TipArea {
        tip: "Open this set — every workspace in it opens as its own tab";
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            StackGlyph {
                ink: sta.has-hover ? Theme.text : Theme.subtext;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.set.name;
                color: Theme.text;
                font-size: 12px;
                overflow: elide;
            }
            Text {
                text: root.set.detail;
                color: Theme.subtext;
                font-size: 10px;
                overflow: elide;
            }
        }
    }
}

// One adoptable session in the detached section (click anywhere on the row to adopt it).
component SessionRowView inherits Rectangle {
    in property <LeftSessionRow> sess;
    callback activate();
    height: 36px;
    border-radius: 5px;
    background: sa.has-hover ? Theme.surface2 : transparent;

    sa := TipArea {
        tip: "Adopt this orphaned session into the current tab — it keeps running, scrollback and all";
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 7px;

        VerticalLayout {
            alignment: center;
            LiveDot {
                live: root.sess.live;
                idle: false;
                tint: Theme.faint;
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.sess.label;
                color: Theme.text;
                font-size: 12px;
                overflow: elide;
            }
            Text {
                text: root.sess.detail;
                color: Theme.subtext;
                font-size: 10px;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            AdoptGlyph { ink: sa.has-hover ? Theme.accent : Theme.faint; }
        }
    }
}

// One resumable session in a TOOL mode (a Claude conversation, a Codex thread). Deliberately
// shaped like SessionRowView above — same height, same two-line label/detail — because the
// two mean the same thing to the user ("something you can pick back up"); only the source
// differs, and a different shape would imply a difference that isn't there.
component SessionItemView inherits Rectangle {
    in property <LeftSessionItem> item;
    // Drawn once per project, above that project's first session. Computed by the caller,
    // which has the index; the row itself never looks at its neighbours.
    in property <bool> heading;
    in property <color> brand;
    callback activate();

    VerticalLayout {
        spacing: 2px;
        if root.heading : Text {
            text: root.item.group;
            color: Theme.subtext;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
            overflow: elide;
        }
        Rectangle {
            height: 34px;
            border-radius: 5px;
            background: ia.has-hover ? Theme.surface2 : transparent;
            ia := TipArea {
                // A blocked row explains itself instead of pretending it will work: the
                // reason is already on the detail line, and the tip repeats it because the
                // detail elides in a narrow panel.
                tip: root.item.blocked ? root.item.detail : "Resume this session";
                mouse-cursor: root.item.blocked ? default : pointer;
                clicked => { if (!root.item.blocked) { root.activate(); } }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 7px;
                VerticalLayout {
                    alignment: center;
                    // A brand-tinted pip rather than a second copy of the tool logo: the
                    // mode strip already says which tool this list belongs to.
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: root.item.blocked
                            ? Theme.faint
                            : (ia.has-hover ? root.brand : Theme.faint);
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.item.label;
                        color: root.item.blocked ? Theme.subtext : Theme.text;
                        font-size: 12px;
                        overflow: elide;
                    }
                    Text {
                        text: root.item.detail;
                        color: Theme.subtext;
                        font-size: 10px;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

// A section heading ("WORKSPACE" / "LIBRARY" / "SETS" / "DETACHED") with its disclosure chevron and
// an optional trailing action button (the library's save-the-current-tab button).
component SectionHead inherits Rectangle {
    in property <string> label;
    in property <bool> open;
    in property <bool> has-action;
    // Per-instance, because this component heads four different sections and its chevron
    // and action glyph mean something different in each.
    in property <string> tip;
    in property <string> action-tip;
    callback toggled();
    callback acted();
    height: 22px;

    // Declared FIRST so the action button's own TouchArea (declared later, on top) wins
    // its clicks; this one is also narrowed to leave the button's corner alone.
    hta := TipArea {
        tip: root.tip;
        x: 0;
        width: root.has-action ? parent.width - 24px : parent.width;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }

    HorizontalLayout {
        spacing: 4px;

        Rectangle {
            width: 18px;
            ChevronGlyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                open: root.open;
                ink: hta.has-hover ? Theme.text : Theme.subtext;
            }
        }

        Text {
            text: root.label;
            color: Theme.subtext;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if root.has-action : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 4px;
                background: aa.has-hover ? Theme.surface2 : transparent;
                SaveGlyph {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    ink: aa.has-hover ? Theme.text : Theme.subtext;
                }
                aa := TipArea {
                    tip: root.action-tip;
                    mouse-cursor: pointer;
                    clicked => { root.acted(); }
                }
            }
        }
    }
}

export component LeftPanel inherits Rectangle {
    // ---- in-flight pane drag (workspace tree) ----
    // `drag-y` is the pointer's ABSOLUTE y, published by the dragged row's TouchArea; each
    // tab group compares it against its own absolute rect and reports itself as the drop
    // target through `hover-changed`. Model INDICES (not uids) travel to the controller:
    // the snapshot the user is looking at is exactly what `resync` last projected, and the
    // controller re-validates both indices before touching any state.
    property <bool> dragging: false;
    property <int> drag-tab: -1;
    property <int> drag-pane: -1;
    property <length> drag-y: 0;
    property <int> drop-tab: -1;
    property <int> drop-slot: -1;

    // per-section disclosure — local UI state, like the sidebar's per-row expansion
    property <bool> tree-open: true;
    property <bool> lib-open: true;
    property <bool> sets-open: true;
    property <bool> det-open: true;

    background: Theme.mantle;
    clip: true;

    // eat stray clicks, so they never fall through to whatever is behind the panel
    TouchArea {}

    // hairline separating the panel from the pane area on its right
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 8px;
        padding-right: 9px;      // 8px + the hairline
        spacing: 4px;

        // ---- panel header: title + close ----
        HorizontalLayout {
            height: 22px;
            spacing: 4px;
            Text {
                text: "PANELS";
                color: Theme.subtext;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 0.5px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 4px;
                    background: xa.has-hover ? Theme.surface2 : transparent;
                    CloseGlyph {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        ink: xa.has-hover ? Theme.text : Theme.subtext;
                    }
                    xa := TipArea {
                        tip: "Hide this panel";
                        mouse-cursor: pointer;
                        clicked => { LeftPanelAdapter.toggle(); }
                    }
                }
            }
        }

        // ---- mode strip: which view the panel is showing ----
        // WORKSPACE first, then one entry per favourited CLI tool. Hidden entirely when
        // nothing is favourited, so a user who has starred no tools sees exactly the panel
        // they saw before modes existed. The height is a CONSTANT, not derived from the
        // buttons: this layout has been broken twice by a child whose size came back
        // through a reactive read (b0c6637, 5c2eef5).
        if LeftPanelAdapter.modes.length > 1 : HorizontalLayout {
            height: 26px;
            spacing: 2px;
            alignment: start;
            for m[i] in LeftPanelAdapter.modes : ModeButton {
                mode-row: m;
                active: LeftPanelAdapter.mode == i;
                // Pure UI state — switching views is not a `State` mutation, so it does
                // not travel Seam #2. See `mode` in types.slint.
                clicked => { LeftPanelAdapter.mode = i; }
            }
        }

        // ===== section 1: the workspace tree (tabs → panes) =====
        if LeftPanelAdapter.mode == 0 : SectionHead {
            label: "WORKSPACE";
            open: root.tree-open;
            tip: root.tree-open ? "Collapse the tab and pane tree" : "Show the tab and pane tree";
            toggled => { root.tree-open = !root.tree-open; }
        }

        if LeftPanelAdapter.mode == 0 && root.tree-open : Rectangle {
            // The tree is the panel's primary view, so it carries twice the weight of a
            // drawer and a floor of one whole tab group. Without the floor, four sections
            // sharing the leftover space squeeze it under a single row's height, and
            // `clip` then hides the tree entirely.
            vertical-stretch: 2;
            min-height: LeftPanelAdapter.tabs.length > 0 ? 88px : 0px;
            clip: true;
            Flickable {
                width: 100%;
                height: 100%;
                viewport-width: self.width;
                viewport-height: treebody.preferred-height;
                treebody := VerticalLayout {
                    alignment: start;
                    spacing: 2px;
                    for t[i] in LeftPanelAdapter.tabs : TabRowView {
                        tab: t;
                        // Two drag sources feed the same hit-test: a row dragged inside the
                        // tree, and a pane torn out of the grid whose pointer the drag pump
                        // publishes on the adapter. Neither knows about the other.
                        drag-active: root.dragging || LeftPanelAdapter.ext-drag;
                        drag-y: root.dragging ? root.drag-y : LeftPanelAdapter.ext-drag-y;
                        drag-pane: root.drag-pane;
                        is-source: root.drag-tab == i;
                        activate(j) => { LeftPanelAdapter.focus-pane(i, j); }
                        drag-moved(j, y) => {
                            root.dragging = true;
                            root.drag-tab = i;
                            root.drag-pane = j;
                            root.drag-y = y;
                        }
                        drag-released => {
                            // Resolve against whichever group last reported itself hovered:
                            // another group is a move, this one is a reorder in place.
                            if (root.drop-tab >= 0 && root.drop-tab != i) {
                                LeftPanelAdapter.move-pane(i, root.drag-pane, root.drop-tab,
                                    max(root.drop-slot, 0));
                            } else if (root.drop-tab == i && root.drop-slot >= 0) {
                                LeftPanelAdapter.reorder-pane(i, root.drag-pane, root.drop-slot);
                            }
                            root.dragging = false;
                            root.drag-tab = -1;
                            root.drag-pane = -1;
                            root.drop-tab = -1;
                            root.drop-slot = -1;
                        }
                        hover-changed(on, slot) => {
                            if (on) {
                                root.drop-tab = i;
                                root.drop-slot = slot;
                            } else if (root.drop-tab == i) {
                                root.drop-tab = -1;
                                root.drop-slot = -1;
                            }
                            // Publish the resolution for an external drag; the pump reads it
                            // on release. Never published for the tree's own drags, which
                            // resolve locally in `drag-released` above.
                            if (LeftPanelAdapter.ext-drag) {
                                LeftPanelAdapter.ext-drop-tab = root.drop-tab;
                                LeftPanelAdapter.ext-drop-slot = root.drop-slot;
                            }
                        }
                    }
                }
            }
        }

        // ===== section 2: the saved-workspace library =====
        if LeftPanelAdapter.mode == 0 : SectionHead {
            label: "LIBRARY";
            open: root.lib-open;
            has-action: true;
            tip: root.lib-open ? "Collapse the saved workspaces" : "Show the saved workspaces";
            action-tip: "Save the current tabs and panes as a workspace";
            toggled => { root.lib-open = !root.lib-open; }
            acted => { LeftPanelAdapter.save-workspace(); }
        }

        if LeftPanelAdapter.mode == 0 && root.lib-open && LeftPanelAdapter.workspaces.length == 0 : Text {
            text: "No saved workspaces yet — save this tab with the button above.";
            color: Theme.subtext;
            font-size: 11px;
            wrap: word-wrap;
        }

        if LeftPanelAdapter.mode == 0 && root.lib-open && LeftPanelAdapter.workspaces.length > 0 : Rectangle {
            vertical-stretch: 1;
            min-height: 44px;
            clip: true;
            Flickable {
                width: 100%;
                height: 100%;
                viewport-width: self.width;
                viewport-height: libbody.preferred-height;
                libbody := VerticalLayout {
                    alignment: start;
                    spacing: 2px;
                    for w[i] in LeftPanelAdapter.workspaces : WorkspaceRowView {
                        ws: w;
                        activate => { LeftPanelAdapter.open-workspace(i); }
                    }
                }
            }
        }

        // ===== section 3: the saved workspace sets =====
        if LeftPanelAdapter.mode == 0 : SectionHead {
            label: "SETS";
            open: root.sets-open;
            has-action: true;
            tip: root.sets-open ? "Collapse the saved sets" : "Show the saved sets";
            action-tip: "Save every tab in this window as a new named set";
            toggled => { root.sets-open = !root.sets-open; }
            acted => { LeftPanelAdapter.save-set(); }
        }

        if LeftPanelAdapter.mode == 0 && root.sets-open && LeftPanelAdapter.sets.length == 0 : Text {
            text: "No saved sets yet — save every tab in this window as one group.";
            color: Theme.subtext;
            font-size: 11px;
            wrap: word-wrap;
        }

        if LeftPanelAdapter.mode == 0 && root.sets-open && LeftPanelAdapter.sets.length > 0 : Rectangle {
            vertical-stretch: 1;
            min-height: 44px;
            clip: true;
            Flickable {
                width: 100%;
                height: 100%;
                viewport-width: self.width;
                viewport-height: setbody.preferred-height;
                setbody := VerticalLayout {
                    alignment: start;
                    spacing: 2px;
                    for st[i] in LeftPanelAdapter.sets : SetRowView {
                        set: st;
                        activate => { LeftPanelAdapter.open-set(i); }
                    }
                }
            }
        }

        // ===== section 4: detached (adoptable) sessions =====
        if LeftPanelAdapter.mode == 0 : SectionHead {
            label: "DETACHED";
            open: root.det-open;
            tip: root.det-open ? "Collapse the orphaned sessions" : "Show sessions still running with no window";
            toggled => { root.det-open = !root.det-open; }
        }

        if LeftPanelAdapter.mode == 0 && root.det-open && LeftPanelAdapter.detached.length == 0 : Text {
            text: "No orphaned sessions. A session that outlives its window lands here.";
            color: Theme.subtext;
            font-size: 11px;
            wrap: word-wrap;
        }

        if LeftPanelAdapter.mode == 0 && root.det-open && LeftPanelAdapter.detached.length > 0 : Rectangle {
            vertical-stretch: 1;
            min-height: 44px;
            clip: true;
            Flickable {
                width: 100%;
                height: 100%;
                viewport-width: self.width;
                viewport-height: detbody.preferred-height;
                detbody := VerticalLayout {
                    alignment: start;
                    spacing: 2px;
                    for s in LeftPanelAdapter.detached : SessionRowView {
                        sess: s;
                        activate => { LeftPanelAdapter.adopt-session(s.uid); }
                    }
                }
            }
        }

        // ===== the tool modes: one favourited tool's locally resumable sessions =====
        // A sibling of the four workspace sections rather than a wrapper around them: this
        // layout's stretch maths is load-bearing (b0c6637), and adding a nesting level to
        // switch views would change it for the workspace mode too. With `mode != 0` every
        // section above is `false` and contributes nothing, so this is the only child left.
        if LeftPanelAdapter.mode != 0 && LeftPanelAdapter.sessions.length == 0 : Text {
            text: "No resumable sessions found for this tool yet.";
            color: Theme.subtext;
            font-size: 11px;
            wrap: word-wrap;
        }

        if LeftPanelAdapter.mode != 0 && LeftPanelAdapter.sessions.length > 0 : Rectangle {
            vertical-stretch: 1;
            clip: true;
            Flickable {
                width: 100%;
                height: 100%;
                viewport-width: self.width;
                viewport-height: sessbody.preferred-height;
                sessbody := VerticalLayout {
                    alignment: start;
                    spacing: 2px;
                    for it[i] in LeftPanelAdapter.sessions : SessionItemView {
                        item: it;
                        // The Rust side sorts by (project, recency), so a project heading is
                        // exactly "the group changed" — no grouping logic in the UI.
                        heading: i == 0 || LeftPanelAdapter.sessions[i - 1].group != it.group;
                        brand: LeftPanelAdapter.modes[LeftPanelAdapter.mode].brand;
                        // The id is the tool's OWN resume key, not an index, so a click can
                        // never race a refresh of the list underneath it.
                        activate => { LeftPanelAdapter.resume-session(it.id); }
                    }
                }
            }
        }
    }
}
