// Data rows shared between the Rust controller and the .slint views. The Rust
// side computes every geometry (logical px) and pushes these as models.

import { HiRect } from "@widgets";

// One tiled pane: the rendered terminal surface + its placement + chrome state.
export struct PaneItem {
    surface: image,
    title: string,
    // optional secondary line under the label (user subtitle / ambient-AI line).
    subtitle: string,
    // ambient-AI summary line, already truncated to the typewriter-revealed prefix by the
    // controller. Shown only when there's no manual `subtitle` and the pane isn't muted.
    ai-subtitle: string,
    // a SHORT shell-type label (e.g. "pwsh", "cmd", "bash", "wsl") derived once at pane
    // creation from the resolved spawn shell program; rendered dim after the title, in the
    // same header row. "" = unknown (e.g. a re-hosted pane) → not shown.
    shell-type: string,
    // per-pane "talk" (speak new Claude assistant replies aloud): drives a small speaker
    // glyph in the header, shown only while on.
    talk: bool,
    accent: color,
    // resolved per-pane chrome (the per-pane override already folded over the global pref
    // by the controller): a clean new pane is frame/dot OFF; a git-project pane is ON.
    show-frame: bool,
    show-dot: bool,
    // true while this pane's label is being edited inline (double-click the header).
    editing: bool,
    x: length,
    y: length,
    w: length,
    h: length,
    visible: bool,
    focused: bool,
    // idle-glow opacity (0 = no glow): the animated alpha of the pane's accent ring once
    // it has been output-quiet past the idle threshold (driven by the controller per tick).
    glow: float,
    // clickable-path hover overlay (driven by the controller after hit-testing the grid).
    link-visible: bool,
    link-x: length,
    link-y: length,
    link-w: length,
    link-tip: string,
    link-tip-x: length,
    link-tip-y: length,
    // drag-to-select highlight rects (one per row-span), hit-tested by the controller from the
    // pane's surface size + font cell metrics; painted over the terminal surface by the widget.
    selection-rects: [HiRect],
    // in-pane search box (opened from the pane menu's "Search…"): whether it's showing + the
    // match counter text (e.g. "2 / 5").
    search-open: bool,
    search-count: string,
    // A monotonically increasing counter bumped every time the search box is (re)invoked
    // (Ctrl+F), even while already open. The widget watches it to (re)focus the query input —
    // a reliable signal that survives the box already being open (unlike a one-shot `init`).
    search-focus-seq: int,
    // Bumped when a keyboard-driven overlay (the New-goal box) opens on this pane's window, so
    // the widget re-focuses this pane's terminal FocusScope (the key route to `on_key`) even
    // when the overlay was opened by mouse/menu with no prior chord.
    refocus-seq: int,
    // Search match highlights projected into the viewport (logical px, hit-tested by the
    // controller from the pane surface): every visible match dimmed, plus the active match drawn
    // distinctly. Without these the box found matches + showed the counter but painted nothing.
    search-rects: [HiRect],
    search-active-on: bool,
    search-active-rect: HiRect,
    // transient bottom-right indicator: copy/paste confirmations + the Ctrl-zoom font "%".
    toast: string,
    // the terminal font size in effect (logical px) — the live zoom / focused-pane font-size
    // state. Drives the widget's `term-font-px` so the toast + search box scale with zoom.
    font-px: length,
    // vim-style scrollbar (right edge): the controller's show-then-fade alpha (0 = hidden/idle)
    // plus the thumb geometry (logical px over the pane surface), recomputed each tick.
    scrollbar-opacity: float,
    scrollbar-thumb-y: length,
    scrollbar-thumb-h: length,
    // how far the viewport is scrolled up from the live edge, in lines (0 = at the bottom).
    // Non-zero raises the jump-to-bottom HUD.
    scroll-offset: int,
    // whether the running app grabbed the mouse (Claude/vim) → forward pointer events to it.
    app-grabs-mouse: bool,
    // Whether the pane's shell has exited (drives the single-layout taskbar's "exited"
    // badge). The native app removes a pane the moment its session exits, so this is
    // structurally always false today — kept for Electron parity / a future status model.
    exited: bool,
    // ---- tool identity (a pane IS a terminal pane; this is what it's RUNNING) ----
    // The `PaneKind` discriminator as an int (`PaneKind::ui_kind`): 0 = plain terminal,
    // 1 = a registered tool, 2.. = the non-PTY views. Drives which chrome the header draws.
    kind: int,
    // Icon kind for the tool mark, allocated from `TOOL_ICON_BASE` and drawn by `Icon`.
    // 0 = no mark (a plain terminal, or a tool id this build does not know). Geometry, never
    // a font glyph — see the drawn-geometry rule at the top of this file.
    tool-icon: int,
    // Human-facing tool name for the header badge ("Claude Code"). "" = not a tool pane.
    tool-name: string,
    // The running program's own last self-reported liveness, as an opaque code:
    // 0 = nothing reported, 1 = busy, 2 = awaiting input, 3 = done, 4 = error. Drives the
    // small dot after the tool mark, so "the agent is waiting for you" is visible without
    // reading the pane. Cleared the moment the shell returns to a prompt — a stale badge
    // is worse than no badge.
    agent-live: int,
    // The tool's brand accent, used for the mark only. The pane's own `accent` still owns
    // the frame/halo, so branding never overrides the user's palette.
    tool-brand: color,
}

// One tab (workspace group) chip in the strip.
export struct TabItem {
    title: string,
    active: bool,
}

// A draggable resize seam (vertical column / horizontal row / main-stack main).
export struct DividerItem {
    x: length,
    y: length,
    w: length,
    h: length,
    vertical: bool,
    // boundary after pane `index` (kind Size); -1 for the main-stack divider.
    index: int,
    main: bool,
}

// One entry in the layout-picker menu.
export struct LayoutOption {
    id: int,        // matches the Rust Layout discriminant order
    label: string,
    active: bool,
    // optional dim hint shown to the right (e.g. the "— grid" the Automatic row resolves
    // to right now in the application menu's Layout submenu); "" = none.
    hint: string,
}

// ===== Wave-2 overlay rows =====

// One visible command-palette row (already filtered + ranked by Rust).
export struct PaletteItem {
    title: string,
    subtitle: string,
}

// One git worktree under a project in the sidebar tree. `branch` is the short label
// (branch name, or "(detached …)" / "(bare)"); `is-main` marks the main checkout, whose
// trash affordance is shown disabled (git refuses `worktree remove` on it). `locked` mirrors
// git's porcelain `locked` flag — git also refuses a plain remove of a locked worktree, so
// its trash is disabled too; `prunable` (stale / missing working dir) is shown as an
// annotation only.
export struct WorktreeRow {
    path: string,
    branch: string,
    is-main: bool,
    locked: bool,
    prunable: bool,
}

// One agent session under a project in the sidebar tree — a row in the History segment.
// `id` is the session id passed to the harness resume command (`claude --resume <id>` for
// Claude); `source` is the harness label ("Claude" today — generic so other harnesses can
// plug in); `summary` is a one-line description (a `summary` transcript line, else the
// first user message); `when` is a relative-time label ("2h ago"); `count` is the
// transcript message count. Built app-side by `sidebar::claude_sessions_for` over
// `core::claude_history`. Declared before `ProjectItem` because that struct references it
// (Slint resolves struct types top-to-bottom within a file — no forward references).
export struct ClaudeSessionItem {
    id: string,
    source: string,
    summary: string,
    when: string,
    count: int,
}

// UI → controller side-channel for the per-project history UI (the Worktrees|History
// segmented bar + the history search box). Slint bumps `seq` after writing the edited
// row's index and its full (segment, query) pair; the controller polls `seq` each pump
// tick, folds the pair into its per-project session-state map (keyed by repo path) and
// re-projects. Polling a global (instead of a new callback) keeps the sidebar
// self-contained — no new app-level callback wiring, mirroring the DELETE-BASE smuggling
// the worktree delete already uses.
export global HistoryUi {
    in-out property <int> seq: 0;
    in-out property <int> proj: -1;       // project row index of the last edit
    in-out property <int> segment: 0;     // 0 = Worktrees, 1 = History
    in-out property <string> query: "";   // history search text
}

// One git-project row in the sidebar panel — now the top level of a two-level tree: the
// project header plus its enumerated `worktrees` (populated by the controller only while
// the flyout is open). Expand/collapse is local UI state in the row itself.
export struct ProjectItem {
    name: string,
    color: color,
    worktrees: [WorktreeRow],
    // This project's recent agent sessions (newest-first), populated by the projection
    // (paneview.rs) from `sidebar::claude_sessions_for` — already FILTERED by `query`.
    sessions: [ClaudeSessionItem],
    // Whether the project has ANY history at all (unfiltered) — gates the Worktrees|History
    // segmented bar. Kept separate from `sessions.length` so a query that matches nothing
    // doesn't collapse the bar (and the search box) out from under the user.
    has-history: bool,
    // The selected segment (0 = Worktrees, 1 = History) — persisted per-project for the app
    // session by the controller (survives the flyout closing and reopening).
    segment: int,
    // The current history search query (persisted alongside `segment`); restores the search
    // box text when the row is recreated.
    query: string,
}

// ===== reminder panes (Track F) =====

// One parked pane in the sidebar bell's reminder list. `uid` is the pane's session uid
// (the restore key — index-free, so a row click can't race a list change); `tint` is the
// pane's project/accent color; `due` is the human due label ("14:32" / "tomorrow 09:00");
// `overdue` flips once the reminder fires (drives the row + bell highlight).
export struct ReminderItem {
    uid: string,
    title: string,
    tint: color,
    due: string,
    overdue: bool,
}

// The reminder-pane bridge between the Rust controller and the sidebar rail. A GLOBAL
// (not AppWindow props) so the feature stays self-contained in sidebar.slint/types.slint:
// the controller pushes `rows`/`open`/`alert` and subscribes to the callbacks via
// `app.global::<RemindersAdapter>()` — no new wiring through app.slint's component tree.
export global RemindersAdapter {
    // Parked panes, oldest-first (the order they were parked).
    in property <[ReminderItem]> rows;
    // Whether the bell's in-rail REMINDERS section is expanded (widens the rail, like
    // the projects section — see app.slint's rail-width binding).
    in property <bool> open;
    // True while any reminder has fired and not been restored (bell badge/accent).
    in property <bool> alert;
    // Fired reminders whose alert toast is still up (not clicked/dismissed, < ~10s old).
    // Projected by the same pump as `rows`; the toast stack in app.slint renders these.
    in property <[ReminderItem]> toasts;
    // Bell icon clicked → toggle the list panel.
    callback toggle();
    // A list row clicked → re-dock that pane into the active tab + clear the reminder.
    // (An alert toast's body click reuses this — same restore path as the bell list.)
    callback restore(string);
    // An alert toast's × clicked → hide just the toast (the reminder + bell badge stay).
    callback toast-dismiss(string);
}

// One option in a preferences picker (font family). `active` marks the current value.
// One row in Preferences → Tools: every tool in the registry, favourited or not. `detected`
// is where `PATH` found the binary ("" when it isn't installed) and `override` is the user's
// own path, which wins when set — the page shows both, because "detected but I want a
// different build" is the whole reason the override exists.
export struct PrefToolRow {
    id: string,
    name: string,
    icon: int,
    brand: color,
    favorite: bool,
    detected: string,
    override: string,
}

// One installed browser in Preferences → Browser. `id` is the platform's own handle for the
// app (a bundle id on macOS, a .desktop name on Linux, a registry key on Windows), passed
// straight back when the user picks one — the UI never parses it.
export struct PrefBrowserRow {
    id: string,
    name: string,
    active: bool,
}

export struct PrefOption {
    id: int,
    label: string,
    active: bool,
}

// One row in the Preferences → Keybindings editor (the EFFECTIVE keymap — overrides over
// defaults): a stable `id` (keys the rebind/reset callbacks), a human label, the chord as
// `<kbd>`-chip parts (e.g. ["Ctrl","Shift","P"]), its category, whether it's the first row of
// that category (so the view draws the group heading above it), whether the user has
// overridden it (shows a reset affordance), and whether it's currently capturing a new chord.
export struct KeybindingItem {
    id: string,
    label: string,
    parts: [string],
    category: string,
    group-first: bool,
    overridden: bool,
    capturing: bool,
    // The user cleared this binding's chord (or it was stolen by another): show "Unbound".
    unbound: bool,
    // A non-rebindable documentation row (the "Focus pane by number → Alt 1…9" line): rendered
    // as static <kbd> pills with no rebind/reset affordances.
    static-row: bool,
}

// ===== context menus (pane header / tab strip) =====

// One row of a cursor-anchored context menu. Built fresh by the controller on each right-click
// so its gating + checkmarks are live. `kind`: -1 separator · 0 plain item · 2 Change-Color
// submenu · 3 Move-to-Tab submenu · 4 Layout submenu.
// `icon` selects a DRAWN leading icon (see MenuIcon in contextmenu.slint) — 0 none ·
// 1 new-pane · 2 command-palette · 3 open-folder · 4 save · 5 preferences ·
// 10+layout-id a layout mini (mirrors theme::menu_icon / theme::layout_icon_kind in Rust).
// Icons used to be font glyph strings (Segoe MDL2 PUA codepoints + ▤▥▦…) but Slint on
// Windows silently drops codepoints the resolved font lacks (the df73005 chevron failure),
// so every icon is now vector geometry keyed by this int.
export struct MenuEntry {
    label: string,
    shortcut: string,
    icon: int,
    kind: int,
    checked: bool,
    show-check: bool,
    disabled: bool,
    danger: bool,
}

// One destination row in the pane menu's "Move to Tab" submenu (label + the real tab index).
export struct CtxTab {
    label: string,
    idx: int,
}

// One frame-palette choice in the Appearance picker: a label plus its 8 slot colors,
// shown as chips. `active` marks the current palette.
export struct FramePaletteOption {
    id: int,
    label: string,
    active: bool,
    colors: [color],
}

// ===== M5: the left slide-out panel (see leftpanel.slint / app/src/leftpanel.rs) =====

// One pane row under a tab in the panel's workspace tree. `uid` is the pane's session uid
// (index-free identity, used by the drag + the detached-list subtraction); `tint` is the
// pane's accent; `live` is the LIVENESS dot's strength (1 = output right now, fading to 0
// across `leftpanel::LIVE_WINDOW_MS`), computed from the SAME activity source the idle glow
// uses (`SessionManager::last_output_at` vs `glow::now_epoch_ms`) — not a second source.
// `idle` mirrors the pane's own idle-glow arming (an AI pane quiet past the alert
// threshold), so the tree flags the pane that's waiting for you.
// Declared before `LeftTabRow` because that struct references it (Slint resolves struct
// types top-to-bottom within a file — no forward references).
export struct LeftPaneRow {
    uid: string,
    title: string,
    tint: color,
    focused: bool,
    live: float,
    idle: bool,
}

// One tab (workspace group) in the panel's tree: its title plus its panes.
export struct LeftTabRow {
    title: string,
    active: bool,
    // The group's colour, and the whole point of it: the accent of the pane this tab
    // focuses — the same colour as that pane's frame halo. A tab in the tree therefore
    // reads as the colour you will see glowing when you switch to it. An empty tab falls
    // back to its own slot in the active frame palette, so every group is coloured.
    tint: color,
    panes: [LeftPaneRow],
}

// One saved workspace in the library section. `path` is the file on disk (the row's real
// identity — the click still travels by index, resolved against the same cached list the
// projection built); `detail` is a dim one-liner ("4 panes · 2h ago").
export struct LeftWorkspaceRow {
    name: string,
    path: string,
    detail: string,
}

// One saved workspace SET in the panel's sets section (mux plan M6). `path` is the
// `sets/*.json` index file; `detail` is a dim one-liner ("4 workspaces · 5m ago").
export struct LeftSetRow {
    name: string,
    path: string,
    detail: string,
}

// One live session that no window in this process is showing — adoptable with one click.
// `uid` is the session uid (the adopt key: index-free, so a row click can't race a list
// change); `detail` is a dim one-liner ("pane-1a2b… · 5m ago").
export struct LeftSessionRow {
    uid: string,
    label: string,
    detail: string,
    live: float,
}

// One entry in the panel's MODE strip. Mode 0 is always WORKSPACE (the tab/pane tree);
// every further mode is one favourited CLI tool, showing that tool's locally resumable
// sessions. `icon` is the registry icon kind the shared `ToolIcon` switches on (0 for the
// workspace mode, which draws its own glyph), and `brand` tints it.
export struct LeftModeRow {
    label: string,
    icon: int,
    brand: color,
}

// One resumable session in a tool mode, grouped under its project. `id` is the tool's own
// resume key (a Claude session uuid, a Codex thread id) — index-free, so a click can't race
// a list refresh. `group` is the project the session belongs to; the view starts a new
// heading whenever it changes, so the Rust side sorts rather than the UI grouping.
export struct LeftSessionItem {
    id: string,
    group: string,
    label: string,
    detail: string,
    // The row cannot be resumed (the project can't be verified, the tool isn't installed).
    // `detail` carries the sentence saying why, so the row still teaches rather than just
    // greying out. Decided once per scan on the background thread — never per frame.
    blocked: bool,
}

// The controller ↔ left-panel bridge. A GLOBAL (not AppWindow props) so the feature stays
// self-contained in leftpanel.slint/types.slint: the projection (`paneview::resync`) pushes
// `open` + the three sections' rows, and `app.rs` subscribes to the callbacks via
// `app.global::<LeftPanelAdapter>()` — the same self-contained wiring `RemindersAdapter`
// uses, with no new callbacks threaded through app.slint's component tree.
export global LeftPanelAdapter {
    // Whether the panel is showing (mirrors `State::left_panel_open`; the width binding
    // lives in app.slint, exactly like the right rail's).
    in property <bool> open;
    // Section 1: this window's tabs, in tab-strip order, each carrying its panes.
    in property <[LeftTabRow]> tabs;
    // Section 2: the saved-workspace library (newest-first).
    in property <[LeftWorkspaceRow]> workspaces;
    // Section 3: the saved workspace sets (newest-first).
    in property <[LeftSetRow]> sets;
    // Section 4: live sessions no window is showing (newest-first).
    in property <[LeftSessionRow]> detached;
    // Panel header ×  → close the panel.
    callback toggle();
    // A pane row clicked → switch to tab `0` and focus its pane `1`.
    callback focus-pane(int, int);
    // A pane row dragged onto another tab → move pane `1` of tab `0` into tab `2`, landing
    // at insertion index `3` among that tab's panes.
    callback move-pane(int, int, int, int);
    // A pane row dragged within its OWN tab → move pane `1` of tab `0` to slot `2`.
    callback reorder-pane(int, int, int);

    // ---- an external (pane-grid) drag hovering the panel ----
    // The drag pump publishes the live pointer here while a pane torn out of the grid is over
    // the panel, and the tree hit-tests it with exactly the machinery it uses for its own row
    // drags — one implementation of "which group is under the cursor", not two. The group and
    // slot it resolves come back through `ext-drop-tab` / `ext-drop-slot` (-1 = none), which
    // the pump reads on release. `ext-drag-y` is window-absolute, matching `absolute-position`.
    in property <bool> ext-drag;
    in property <length> ext-drag-y;
    in-out property <int> ext-drop-tab: -1;
    in-out property <int> ext-drop-slot: -1;
    // A library row clicked → load saved workspace `0` (index into `workspaces`).
    callback open-workspace(int);
    // The library header's ＋ → save the active tab into the library.
    callback save-workspace();
    // A set row clicked → open every member workspace of set `0` (index into `sets`).
    callback open-set(int);
    // The sets header's ＋ → save every non-empty tab as a new named set.
    callback save-set();
    // A detached row clicked → adopt session `0` into the active tab.
    callback adopt-session(string);

    // ---- panel modes ----
    // Which view the panel is showing: 0 = WORKSPACE (the tree above), n = `modes[n]`, a
    // favourited tool's resumable-session list. `in-out` because the strip sets it directly
    // — switching views is pure UI state, not a `State` mutation, so it does not go through
    // Seam #2 (the mode does not survive a restart, and should not: the panel always opens
    // on the workspace tree).
    in-out property <int> mode: 0;
    // Every available mode, mode 0 first. Projected from the favourites in `Settings`, so a
    // tool the user has not starred never appears here.
    in property <[LeftModeRow]> modes;
    // The current mode's sessions, already sorted by (project, recency) — the view only
    // draws a heading when `group` changes.
    in property <[LeftSessionItem]> sessions;
    // A session row clicked → resume session `0` of the current mode's tool.
    callback resume-session(string);
}
